# Copy to .env.local and fill in the values you need.
# Public (shipped to the browser) — never put secrets in NEXT_PUBLIC_* vars.

NEXT_PUBLIC_WC_PROJECT_ID=

# Optional override; the public default lives in src/utils/clarity.ts
# NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Optional dedicated RPCs (public fallbacks are used when empty)
NEXT_PUBLIC_BASE_RPC_URL=
NEXT_PUBLIC_SEPOLIA_RPC_URL=
NEXT_PUBLIC_ROBINHOOD_RPC_URL=
